# Copy to .env.local (never commit real keys). Provider keys never use NEXT_PUBLIC_.

# Claude model per route: "sonnet" (claude-sonnet-5-5), "haiku" (claude-haiku-5-5),
# or a full Claude model id. Leave blank for Sonnet.
AI_CHECK_MODEL=
AI_EXTRACT_MODEL=

# Reasoning depth: low | medium | high. Start low for latency, measure before raising.
AI_EFFORT=low
# Total server deadline per check, including the one retry.
AI_TIMEOUT_MS=20000

ANTHROPIC_API_KEY=

# UI-only: use lib/mock.ts instead of calling the API (clearly labeled demo simulation).
NEXT_PUBLIC_MOCK=0

# Optional stable signing key for imported homework. Defaults to ANTHROPIC_API_KEY.
# Keep stable across deployments so saved homework can still be checked.
PROBLEM_SIGNING_SECRET=

# Supabase: accounts (log in / sign up), saved worksheets + work, figure storage, and Race a friend.
# Dashboard → Project Settings → API Keys. Leave blank to keep everything in this browser (no log in).
# Publishable key only; it is safe in the browser because RLS guards every table.
# Never add the secret / service_role key here or anywhere NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
