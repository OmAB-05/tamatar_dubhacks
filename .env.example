# Copy to .env.local (never commit real keys). Provider keys never use NEXT_PUBLIC_.

# Which provider runs each route: "anthropic" or "gemini".
AI_PROVIDER=anthropic
# Optional per-route overrides, e.g. Gemini for PDF extraction:
# AI_CHECK_PROVIDER=anthropic
# AI_EXTRACT_PROVIDER=gemini

# Leave blank to use the provider default (claude-sonnet-5-5 / gemini-3.8-flash).
AI_CHECK_MODEL=
AI_EXTRACT_MODEL=

# Reasoning depth: low | medium | high. Start low for latency, measure before raising.
AI_EFFORT=low
# Total server deadline per check, including the one retry.
AI_TIMEOUT_MS=20000

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# UI-only: use lib/mock.ts instead of calling the API (clearly labeled demo simulation).
NEXT_PUBLIC_MOCK=0

# Optional stable signing key for imported homework. Defaults to a server provider key.
# Keep stable across deployments so saved homework can still be checked.
PROBLEM_SIGNING_SECRET=
